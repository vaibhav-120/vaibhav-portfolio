{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "api/_data/knowledge.md",
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,evals/**,scripts/**,api/_data/voices/**,**/piper/hebrew/*.onnx,**/onnxruntime/transformers/**,**/onnxruntime/quantization/**,**/onnxruntime/tools/**}"
    },
    "api/tts.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,evals/**,scripts/**,api/_data/voices/**,api/_data/knowledge.md,**/piper/hebrew/*.onnx,**/onnxruntime/transformers/**,**/onnxruntime/quantization/**,**/onnxruntime/tools/**}"
    }
  },
  "rewrites": [
    { "source": "/api/tts", "destination": "/api/tts" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}