# Copy to .env for local development. Set the same values in Vercel:
# Project → Settings → Environment Variables. Never commit .env.

# Required. Free-tier key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Models tried in order; the next one is used when one is rate-limited.
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional but recommended. Comma-separated words the agent must never say,
# such as client company names. Kept here so they never appear in the repo.
BLOCKED_TERMS=

# Optional. Per-visitor limit: RATE_LIMIT_MAX questions per RATE_LIMIT_WINDOW seconds.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=600

# Optional. Piper voice file name in api/_data/voices (without .onnx).
PIPER_VOICE=en_US-lessac-medium

# Optional. Folder the voice is downloaded from at runtime (on Vercel).
PIPER_VOICE_BASE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/lessac/medium