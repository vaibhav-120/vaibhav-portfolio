---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="wrap page">
    <a class="back" href="/notes/"><Icon name="back" /> All notes</a>
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
    <div class="prose body"><Content /></div>
  </article>
</Base>

<style>
  .page { padding-block: 2rem 5rem; }
  .back { display: inline-flex; align-items: center; gap: .2rem; color: var(--muted); text-decoration: none; font-size: .95rem; margin-bottom: 2rem; }
  .back :global(svg) { width: 18px; height: 18px; }
  h1 { max-width: 24ch; }
  time { display: block; margin-top: .75rem; color: var(--muted); font-size: .9rem; }
  .body { margin-top: 2rem; }
</style>
