---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const hasNotes = (await getCollection('notes', ({ data }) => !data.draft)).length > 0;
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#education', label: 'Education' },
  ...(hasNotes ? [{ href: '/notes/', label: 'Notes' }] : []),
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">{profile.name}</a>
    <nav aria-label="Main" class="main-nav">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <ul class="social">
      <li>
        <a class="icon-link" href={profile.links.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn">
          <Icon name="linkedin" />
        </a>
      </li>
      {profile.links.github && (
        <li>
          <a class="icon-link" href={profile.links.github} rel="me noopener" target="_blank" aria-label="GitHub">
            <Icon name="github" />
          </a>
        </li>
      )}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 1rem 1.5rem; min-height: 64px; }
  .brand { font-weight: 650; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; margin-right: auto; }
  ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .main-nav ul { gap: clamp(1rem, 2.2vw, 1.6rem); }
  .social { gap: .5rem; }
  a { color: var(--muted); text-decoration: none; font-size: .96rem; }
  a:hover { color: var(--ink); }
  .icon-link { display: inline-flex; padding: 4px; }
  .icon-link :global(svg) { width: 18px; height: 18px; }

  /* Small screens: brand and icons on the first row, section links on a second row. */
  @media (max-width: 680px) {
    .bar { flex-wrap: wrap; padding-top: .75rem; min-height: 0; gap: .4rem 1rem; }
    .main-nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
    .main-nav ul { gap: 1.25rem; padding: .25rem 0 .7rem; }
    .main-nav a { white-space: nowrap; font-size: .92rem; }
  }
</style>
