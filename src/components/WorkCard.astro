---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const { title, summary, metric, stack, featured } = entry.data;
const href = `/work/${entry.id}/`;
---
<article class:list={['card', { featured }]}>
  <h3><a href={href}>{title}</a></h3>
  <p class="summary">{summary}</p>
  {featured && metric && (
    <p class="metric"><strong>{metric.value}</strong> <span>{metric.label}</span></p>
  )}
  <ul class="tags">{stack.slice(0, featured ? 5 : 3).map((s) => <li>{s}</li>)}</ul>
</article>

<style>
  .card {
    position: relative;
    display: flex; flex-direction: column; gap: .7rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.25rem;
  }
  .card:hover { border-color: var(--line-strong); }
  .card:focus-within { border-color: var(--accent); }
  h3 a { color: var(--ink); text-decoration: none; }
  /* The whole card is clickable through the title link. */
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  h3 a:focus-visible { outline: none; }
  .summary { color: var(--muted); font-size: .98rem; }
  .tags { margin-top: auto; padding-top: .3rem; }

  .featured {
    border-radius: var(--r-lg);
    padding: clamp(1.4rem, 3vw, 2rem);
    gap: .9rem;
  }
  .featured h3 { font-size: 1.5rem; }
  .featured .summary { font-size: 1.02rem; max-width: 46ch; }
  .metric {
    display: flex; flex-direction: column; gap: .1rem;
    border-left: 3px solid var(--accent);
    padding: .2rem 0 .2rem .9rem; margin-block: .3rem;
  }
  .metric strong { font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 650; letter-spacing: -0.02em; line-height: 1.1; }
  .metric span { color: var(--muted); font-size: .9rem; }
</style>
