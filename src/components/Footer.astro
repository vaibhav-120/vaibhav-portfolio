---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <p>© {year} {profile.name}. {profile.location}.</p>
    <ul>
      <li><a href={profile.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
      {profile.links.github && <li><a href={profile.links.github} rel="me noopener" target="_blank">GitHub</a></li>}
      {profile.links.resume && <li><a href={profile.links.resume} rel="noopener" target="_blank">Résumé</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 2rem; color: var(--muted); font-size: .92rem; }
  .row { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); }
  a:hover { color: var(--ink); }
</style>
